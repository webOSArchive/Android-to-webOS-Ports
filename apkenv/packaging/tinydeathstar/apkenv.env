# launch settings for Star Wars: Tiny Death Star 1.4.1 (Cocos2d-x 2.0.4; modules/cocos2dx.c)
# FMOD Ex asks for thread stacks glibc rejects (PORTING-PLAYBOOK.md §4 Audio).
APKENV_PTHREAD_STACK_CLAMP=1
# LucasArts loading screen over the first load; rebuild the payload with:
#   ASSET=res/drawable-xhdpi/splash.png NAME=tinydeathstar \
#   tools/tr2-extract-splash.sh packaging/tinydeathstar.apk packaging/extras/tinydeathstar 768x1024 contain
APKENV_SPLASH_RGB=android/extras/tinydeathstar-splash-768x1024-rgb.raw
APKENV_SPLASH_SIZE=768x1024
