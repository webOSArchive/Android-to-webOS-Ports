# Dead Space (EA BLAST; modules/eablast.c). See plan/DEAD-SPACE.md.

# EAThread sets explicit pthread stacks (pthread_attr_setstack AND
# setstacksize). That is the shape that silently killed Aralon's music: glibc
# rejects stacks under 16 KB with EINVAL and the engine maps any
# pthread_attr_* failure to a generic error. On from run one, not after a
# day of chasing a missing thread.
APKENV_PTHREAD_STACK_CLAMP=1

# Where published/ lives inside the app dir. The module chdir()s here, because
# the engine reads its 319 MB of content with relative fopen/mmap and cannot
# read it out of the apk - so it is shipped as real files and read in place,
# never copied to /media/internal.
APKENV_BLAST_CONTENT=android/extras

# Dead Space lays its UI out for a WIDER surface than the TouchPad's 4:3: at a
# raw 1024x768 the main menu's buttons overlap ("Options" runs into "Extras").
# Present a 16:10 surface centred on the screen - 1024x640 with 64px bars top
# and bottom - and shift the engine's viewport/scissor and our touches to match.
# Same mechanism as PvZ HD's letterbox.
APKENV_BLAST_LOGICAL=1280x800
