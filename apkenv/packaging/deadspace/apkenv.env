# Dead Space (EA BLAST; modules/eablast.c). See plan/DEAD-SPACE.md.

# EAThread sets explicit pthread stacks (pthread_attr_setstack AND
# setstacksize). That is the shape that silently killed Aralon's music: glibc
# rejects stacks under 16 KB with EINVAL and the engine maps any
# pthread_attr_* failure to a generic error. On from run one, not after a
# day of chasing a missing thread.
APKENV_PTHREAD_STACK_CLAMP=1

# Where published/ lives inside the app dir. The module chdir()s here, because
# the engine reads its 319 MB of content with relative fopen/mmap and cannot
# read it out of the apk - so it is shipped as real files and read in place,
# never copied to /media/internal.
APKENV_BLAST_CONTENT=android/extras

# Letterbox, and it is a genuine trade-off rather than a straight fix. Measured
# from the engine's own projection matrices (APKENV_GL_DEBUG, [GLPROJ]):
#
#   * The 3D DOES adapt. It holds horizontal FOV fixed (~53 deg) and lets
#     vertical follow the aspect: 41.3 deg at 4:3 vs 34.4 deg at 16:10. So a
#     taller surface genuinely SEES MORE, and letterboxing costs real field of
#     view in play.
#   * The UI does NOT. Its ortho space is a fixed 320 units tall and
#     320*aspect wide - 426 units at 4:3, 512 at 16:10 - so menu elements laid
#     out for the wider design overlap at 4:3 ("Options" runs into "Extras").
#
# 3:2 is the compromise: enough UI width that the menu lays out correctly,
# while giving back most of the vertical FOV that 16:10 would cost.
# 1500x1000 on 1024x768 -> a 1024x682 surface with 43px bars (vs 64px at 16:10).
#
# Comment this out for full 1024x768 and maximum in-game view, at the price of
# an overlapping main menu. Note that 4:3 shows MORE than the game was framed
# for, which is not automatically better - cutscenes are authored for the
# wider aspect.
APKENV_BLAST_LOGICAL=1500x1000
