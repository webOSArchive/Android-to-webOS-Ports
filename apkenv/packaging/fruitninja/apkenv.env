# launch settings for Fruit Ninja 1.8.8 (Halfbrick Mortar; modules/mortar.c)
# Dialogs: 0 = the negative/"no" button (MortarDialog$3$2), 1 = positive,
# -1 = leave unanswered. 0 is the safe default: the identified dialog is the
# quit confirmation. See plan/FRUITNINJA.md §2e.
APKENV_MORTAR_DIALOG_BUTTON=0
